{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn",
    "style": "off"
  },
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y"],
  "ignorePatterns": [
    "dist/",
    "node_modules/",
    "_bmad/**",
    "_bmad-output/**",
    "backlog/**",
    "prototypes/**",
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "tools/oxlint/anti-slop/**"
  ],
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "./tools/oxlint/anti-slop/index.ts"
    },
    {
      "name": "muster-roll",
      "specifier": "./tools/oxlint/muster-roll/index.ts"
    },
    "eslint-plugin-better-tailwindcss",
    {
      "name": "playwright",
      "specifier": "eslint-plugin-playwright"
    }
  ],
  "settings": {
    "better-tailwindcss": {
      "entryPoint": "src/ui/main.css",
      "selectors": {
        "extends": [
          {
            "kind": "variable",
            "name": "^.*_CLASS$"
          }
        ]
      }
    }
  },
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@owlbear-rodeo/sdk",
            "message": "Only src/platform/obr may import the Owlbear SDK. Use the ports in src/platform/ports.ts."
          }
        ],
        "patterns": [
          {
            "group": ["@owlbear-rodeo/sdk/**"],
            "message": "Only src/platform/obr may import the Owlbear SDK. Use the ports in src/platform/ports.ts."
          },
          {
            "group": [
              "**/platform/obr",
              "**/platform/obr/**",
              "**/platform/mock",
              "**/platform/mock/**",
              "./obr",
              "./obr/**",
              "../obr",
              "../obr/**",
              "./mock",
              "./mock/**",
              "../mock",
              "../mock/**"
            ],
            "message": "Import the adapter through @/platform/current, so the build mode picks it."
          }
        ]
      }
    ],
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-func": "error",
    "oxc/no-accumulating-spread": "error",
    "anti-slop/no-array-filter-map": "error",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-readable-spacing": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    "muster-roll/no-hand-assembled-classname": "error",
    "better-tailwindcss/no-unknown-classes": "error",
    "better-tailwindcss/no-conflicting-classes": "error",
    "better-tailwindcss/no-concatenated-classes": "error",
    "better-tailwindcss/no-duplicate-classes": "warn",
    "better-tailwindcss/no-unnecessary-whitespace": "warn",
    "better-tailwindcss/no-deprecated-classes": "warn",
    "better-tailwindcss/enforce-canonical-classes": "warn",
    "better-tailwindcss/enforce-consistent-variant-order": "warn",
    "react/react-in-jsx-scope": "off",
    "react/exhaustive-deps": "error",
    "react/immutability": "error",
    "react/preserve-manual-memoization": "error",
    "react/refs": "error",
    "react/set-state-in-effect": "error",
    "react/use-memo": "error",
    "jsx-a11y/aria-role": "error",
    "jsx-a11y/heading-has-content": "error",
    "jsx-a11y/no-autofocus": "error",
    "jsx-a11y/no-noninteractive-element-interactions": "error",
    "jsx-a11y/no-noninteractive-element-to-interactive-role": "error",
    "jsx-a11y/prefer-tag-over-role": "error",
    "jsx-a11y/role-has-required-aria-props": "error"
  },
  "overrides": [
    {
      "files": ["src/core/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@owlbear-rodeo/sdk",
                "message": "Only src/platform/obr may import the Owlbear SDK. Use the ports in src/platform/ports.ts."
              },
              {
                "name": "react",
                "message": "The core layer is framework-independent."
              },
              {
                "name": "react-dom",
                "message": "The core layer is framework-independent."
              }
            ],
            "patterns": [
              {
                "group": ["@owlbear-rodeo/sdk/**", "react/**", "react-dom/**"],
                "message": "The core layer is framework-independent and cannot import platform SDKs."
              },
              {
                "group": [
                  "**/platform/obr",
                  "**/platform/obr/**",
                  "**/platform/mock",
                  "**/platform/mock/**",
                  "./obr",
                  "./obr/**",
                  "../obr",
                  "../obr/**",
                  "./mock",
                  "./mock/**",
                  "../mock",
                  "../mock/**"
                ],
                "message": "Import the adapter through @/platform/current, so the build mode picks it."
              },
              {
                "group": [
                  "@/platform",
                  "@/platform/**",
                  "@/replica",
                  "@/replica/**",
                  "@/ui",
                  "@/ui/**",
                  "@/builder",
                  "@/builder/**"
                ],
                "message": "The core layer cannot depend on application layers."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/replica/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@owlbear-rodeo/sdk",
                "message": "Only src/platform/obr may import the Owlbear SDK. Use the ports in src/platform/ports.ts."
              }
            ],
            "patterns": [
              {
                "group": ["@owlbear-rodeo/sdk/**"],
                "message": "Only src/platform/obr may import the Owlbear SDK. Use the ports in src/platform/ports.ts."
              },
              {
                "group": [
                  "**/platform/obr",
                  "**/platform/obr/**",
                  "**/platform/mock",
                  "**/platform/mock/**",
                  "./obr",
                  "./obr/**",
                  "../obr",
                  "../obr/**",
                  "./mock",
                  "./mock/**",
                  "../mock",
                  "../mock/**"
                ],
                "message": "Import the adapter through @/platform/current, so the build mode picks it."
              },
              {
                "group": ["@/ui", "@/ui/**", "@/builder", "@/builder/**"],
                "message": "The replica layer cannot depend on UI or builder."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/platform/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@owlbear-rodeo/sdk",
                "message": "Only src/platform/obr may import the Owlbear SDK. Use the ports in src/platform/ports.ts."
              }
            ],
            "patterns": [
              {
                "group": ["@owlbear-rodeo/sdk/**"],
                "message": "Only src/platform/obr may import the Owlbear SDK. Use the ports in src/platform/ports.ts."
              },
              {
                "group": [
                  "**/platform/obr",
                  "**/platform/obr/**",
                  "**/platform/mock",
                  "**/platform/mock/**",
                  "./obr",
                  "./obr/**",
                  "../obr",
                  "../obr/**",
                  "./mock",
                  "./mock/**",
                  "../mock",
                  "../mock/**"
                ],
                "message": "Import the adapter through @/platform/current, so the build mode picks it."
              },
              {
                "group": [
                  "@/replica",
                  "@/replica/**",
                  "@/ui",
                  "@/ui/**",
                  "@/builder",
                  "@/builder/**"
                ],
                "message": "The platform layer cannot depend on application layers."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/platform/obr/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/platform/obr",
                  "**/platform/obr/**",
                  "**/platform/mock",
                  "**/platform/mock/**",
                  "./obr",
                  "./obr/**",
                  "../obr",
                  "../obr/**",
                  "./mock",
                  "./mock/**",
                  "../mock",
                  "../mock/**"
                ],
                "message": "Import the adapter through @/platform/current, so the build mode picks it."
              },
              {
                "group": [
                  "@/replica",
                  "@/replica/**",
                  "@/ui",
                  "@/ui/**",
                  "@/builder",
                  "@/builder/**"
                ],
                "message": "The platform layer cannot depend on application layers."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/builder/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@owlbear-rodeo/sdk",
                "message": "Only src/platform/obr may import the Owlbear SDK. Use the ports in src/platform/ports.ts."
              }
            ],
            "patterns": [
              {
                "group": ["@owlbear-rodeo/sdk/**"],
                "message": "Only src/platform/obr may import the Owlbear SDK. Use the ports in src/platform/ports.ts."
              },
              {
                "group": [
                  "**/platform/obr",
                  "**/platform/obr/**",
                  "**/platform/mock",
                  "**/platform/mock/**",
                  "./obr",
                  "./obr/**",
                  "../obr",
                  "../obr/**",
                  "./mock",
                  "./mock/**",
                  "../mock",
                  "../mock/**"
                ],
                "message": "Import the adapter through @/platform/current, so the build mode picks it."
              },
              {
                "group": ["@/replica", "@/replica/**", "@/platform", "@/platform/**"],
                "message": "The builder layer cannot depend on replica or platform."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/ui/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@owlbear-rodeo/sdk",
                "message": "Only src/platform/obr may import the Owlbear SDK. Use the ports in src/platform/ports.ts."
              }
            ],
            "patterns": [
              {
                "group": ["@owlbear-rodeo/sdk/**"],
                "message": "Only src/platform/obr may import the Owlbear SDK. Use the ports in src/platform/ports.ts."
              },
              {
                "group": [
                  "**/platform/obr",
                  "**/platform/obr/**",
                  "**/platform/mock",
                  "**/platform/mock/**",
                  "./obr",
                  "./obr/**",
                  "../obr",
                  "../obr/**",
                  "./mock",
                  "./mock/**",
                  "../mock",
                  "../mock/**"
                ],
                "message": "Import the adapter through @/platform/current, so the build mode picks it."
              },
              {
                "group": ["@/replica", "@/replica/**", "@/builder", "@/builder/**"],
                "message": "The UI layer cannot depend on replica or builder."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["tests/**/*.e2e.ts", "tests/support/**"],
      "rules": {
        "playwright/expect-expect": "warn",
        "playwright/max-nested-describe": "warn",
        "playwright/missing-playwright-await": "error",
        "playwright/no-conditional-expect": "warn",
        "playwright/no-conditional-in-test": "warn",
        "playwright/no-duplicate-hooks": "warn",
        "playwright/no-duplicate-slow": "warn",
        "playwright/no-element-handle": "warn",
        "playwright/no-eval": "warn",
        "playwright/no-focused-test": "error",
        "playwright/no-force-option": "warn",
        "playwright/no-identical-title": "warn",
        "playwright/no-nested-step": "warn",
        "playwright/no-networkidle": "error",
        "playwright/no-page-pause": "warn",
        "playwright/no-skipped-test": "warn",
        "playwright/no-standalone-expect": "error",
        "playwright/no-unnecessary-assertions": "error",
        "playwright/no-unsafe-references": "error",
        "playwright/no-unused-locators": "error",
        "playwright/no-useless-await": "warn",
        "playwright/no-useless-not": "warn",
        "playwright/no-wait-for-navigation": "error",
        "playwright/no-wait-for-selector": "warn",
        "playwright/no-wait-for-timeout": "error",
        "playwright/prefer-hooks-in-order": "warn",
        "playwright/prefer-hooks-on-top": "warn",
        "playwright/prefer-locator": "warn",
        "playwright/prefer-to-have-count": "warn",
        "playwright/prefer-to-have-length": "warn",
        "playwright/prefer-web-first-assertions": "error",
        "playwright/valid-describe-callback": "error",
        "playwright/valid-expect": "error",
        "playwright/valid-expect-in-promise": "error",
        "playwright/valid-test-tags": "error",
        "playwright/valid-title": "error"
      }
    }
  ]
}
