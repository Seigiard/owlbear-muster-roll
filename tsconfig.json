{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "ES2023.Intl", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["bun", "vite/client"],
    "paths": {
      "@/platform/current": ["./src/platform/mock/index.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "tests", "scripts", "tools/mutants", "tools/oxlint/muster-roll", "*.ts"]
}
